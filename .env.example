# Copy this file to .env and fill in the values. .env is git-ignored; this example is committed (values empty).
# The scripts read these from the environment; load .env with your shell / `uv run --env-file .env ...`.

# OpenAI Decisions API (only needed when measuring an OpenAI model)
OPENAI_API_KEY=
# Model name to use (the script default when empty)
OPENAI_DECISION_MODEL=

# Contact for the Wikimedia API (REQUIRED for datasets/fetch: goes into the User-Agent; an e-mail address or the repository URL)
WIKIQA_CONTACT=

# Optional
# WIKIQA_CACHE=      where fetched API responses are cached (default work/cache)
# WIKI_SET=          commons | synthetic | reasoning
# PX=224             longest side of the pictures given to the models
# WORKERS=           parallelism (API runs only)
